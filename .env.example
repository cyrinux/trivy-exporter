# Trivy Exporter - Configuration Example
# Copy this file to .env and adjust values according to your needs

# Log level (debug, info, warn, error)
LOG_LEVEL=info

# SQLite database and results storage directory
RESULTS_DIR=/results

# Docker socket or URL to monitor
DOCKER_HOST=unix:///var/run/docker.sock
# For remote Docker:
# DOCKER_HOST=tcp://docker-host:2375

# Trivy server URL (client-server mode)
TRIVY_SERVER_URL=http://localhost:4954
# For remote Trivy server:
# TRIVY_SERVER_URL=http://trivy-server:4954

# Additional arguments for Trivy
# Examples:
# - Ignore unfixed vulnerabilities: --ignore-unfixed
# - Filter by severity: --severity HIGH,CRITICAL
# - Ignore certain CVEs: --ignorefile .trivyignore
TRIVY_EXTRA_ARGS=--ignore-unfixed

# Number of parallel scan workers
# Increase to scan multiple images simultaneously
NUM_WORKERS=1

# Periodic scan interval in minutes (not currently implemented)
SCAN_INTERVAL_MINUTES=15

# ====================================
# OpenAI - AI CVE Analysis
# ====================================

# OpenAI API key for automatic CVE analysis
# Leave empty to disable AI analysis
OPENAI_API_KEY=

# OpenAI model to use
# Options: gpt-4o, gpt-4-turbo, gpt-3.5-turbo, etc.
OPENAI_MODEL=gpt-4-turbo

# ====================================
# Alerts - ntfy.sh
# ====================================

# ntfy.sh webhook URL to receive alerts
# Examples:
# - Public topic: https://ntfy.sh/mytopic
# - Private topic with auth: https://user:pass@ntfy.example.com/mytopic
# Leave empty to disable alerts
NTFY_WEBHOOK_URL=

# ====================================
# Observability - Tracing and Profiling
# ====================================

# Tempo endpoint for OpenTelemetry tracing (OTLP gRPC)
TEMPO_ENDPOINT=localhost:4317

# Pyroscope endpoint for continuous profiling
PYROSCOPE_ENDPOINT=http://localhost:4040

# Completely disable tracing and profiling
# Useful in production without observability stack
DISABLE_TRACING_PROFILING=false

# ====================================
# Docker Configuration (via labels)
# ====================================

# You can also control scanning via Docker labels:
# docker run -d --label trivy.scan=false myimage:latest
# docker run -d --label trivy.scanners=vuln,secret myimage:latest
